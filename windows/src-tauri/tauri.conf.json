{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Side B",
  "version": "1.4.0",
  "identifier": "com.fefucho.sideb.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Side B",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,DeviceBoundSessions --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/AnimatedArtwork/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "libmpv-2.dll",
      "vulkan-1.dll",
      "VulkanRT-License.txt",
      "provider/spotify-canvas/manifest.json",
      "provider/spotify-canvas/sideb-spotify-canvas.exe",
      "provider/spotify-canvas/LICENSE",
      "provider/spotify-canvas/THIRD_PARTY_NOTICES.md",
      "provider/spotify-canvas/SHA256SUMS",
      "provider/spotify-jam/sideb-spotify-jam.exe",
      "provider/spotify-jam/LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis_hooks.nsh"
      }
    }
  }
}
